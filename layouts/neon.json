{
  "id": "root",
  "type": "row",
  "preview": "layouts/neon.svg",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "neon-grid",
  "font": "JetBrains Mono",
  "ui_font": "Geist Mono",
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 0.86,
  "background": {
    "gradient": [
      "#0a1430",
      "#04060c"
    ],
    "angle": 160
  },
  "divider": {
    "width": 1,
    "color": "#00f0ff33"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 260
      },
      "min": 44,
      "max": 480,
      "background": "#060a13e6",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "divider": {
            "width": 1,
            "color": "border"
          },
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "neon-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "border": {
            "width": 1,
            "color": "#00f0ff22"
          },
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 12,
          "gap": 12,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 12,
                  "radius": 4,
                  "background": "#070b14",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "#1f4766"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#00f0ff"
                  },
                  "header": {
                    "content": {
                      "mod": "neon-pane"
                    },
                    "height": 28,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "radius": 4,
              "border": {
                "width": 1,
                "color": "#1f4766"
              },
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "neon-hud"
          }
        }
      ]
    }
  ]
}